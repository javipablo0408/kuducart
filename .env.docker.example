# Ports exposed on the VPS host
FRONTEND_PORT=3010
MEDUSA_PORT=9010

# Postgres
POSTGRES_DB=medusa
POSTGRES_USER=medusa
POSTGRES_PASSWORD=change_me

# Medusa CORS and security
STORE_CORS=https://kuducart.co.za
ADMIN_CORS=https://api.kuducart.co.za,https://api.kuducart.co.za/app
AUTH_CORS=https://kuducart.co.za,https://api.kuducart.co.za
JWT_SECRET=change_me_jwt_secret_please_use_a_long_random_value
COOKIE_SECRET=change_me_cookie_secret_please_use_a_long_random_value

# Stripe (optional)
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# Frontend public envs
NEXT_PUBLIC_MEDUSA_URL=https://api.kuducart.co.za
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_your_publishable_key
NEXT_PUBLIC_MEDUSA_REGION_ID=reg_your_region_id
NEXT_PUBLIC_MEDUSA_PAYMENT_PROVIDER_ID=pp_system_default

# --- Solo Docker Swarm / Portainer Swarm (docker-compose.prod.swarm.yml) ---
# Construye y sube las imágenes primero, luego define:
# MEDUSA_IMAGE=tu_usuario/kuducart-medusa:latest
# FRONTEND_IMAGE=tu_usuario/kuducart-frontend:latest
