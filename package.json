{
  "name": "kuducart",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint app components hooks lib services types next.config.ts",
    "dev:frontend": "next dev",
    "dev:backend": "npm --prefix backend run dev",
    "db:up": "docker compose up -d postgres redis",
    "db:down": "docker compose down",
    "medusa:migrate": "npx --prefix backend medusa db:migrate",
    "medusa:seed": "npm --prefix backend run seed",
    "setup:medusa": "./scripts/setup-medusa.sh",
    "docker:prod:up": "docker compose --env-file .env.docker -f docker-compose.prod.yml up -d --build",
    "docker:prod:down": "docker compose --env-file .env.docker -f docker-compose.prod.yml down",
    "docker:prod:logs": "docker compose --env-file .env.docker -f docker-compose.prod.yml logs -f"
  },
  "dependencies": {
    "next": "16.2.1",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
